datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  liveUrl     String?
  githubUrl   String?
  tags        String[]
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  company   String?
  avatarUrl String?
  text      String
  rating    Int      @default(5)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlogVideo {
  id        Int      @id @default(autoincrement())
  videoId   String
  caption   String
  tags      String[]
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model OrgExperience {
  id           Int      @id @default(autoincrement())
  period       String
  organization String
  role         String
  description  String   @default("")
  highlights   String[]
  type         String   @default("organization")
  logo         String?
  order        Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model ApiToken {
  id         Int       @id @default(autoincrement())
  name       String
  tokenHash  String    @unique
  prefix     String
  scope      String    @default("read")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}
